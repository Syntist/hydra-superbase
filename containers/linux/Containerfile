FROM docker.io/library/node:24.16.0-trixie

ARG RUST_VERSION=1.98.1
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates cmake curl fakeroot file \
    gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 git \
    libasound2t64 libatk-bridge2.0-0 libatspi2.0-0 libdrm2 libgbm1 \
    libgtk-3-0t64 libnss3 libx11-xcb1 libxkbcommon0 libxss1 libxtst6 \
    ninja-build patchelf pkg-config python3 rpm rsync squashfs-tools \
    unzip xz-utils zip \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain ${RUST_VERSION} \
    && rustup target add x86_64-pc-windows-gnu \
    && chmod -R a+rX /opt/rustup /opt/cargo

# Run a real packaged-app startup check on a virtual display before export.
RUN apt-get update && apt-get install -y --no-install-recommends xvfb xauth \
    && rm -rf /var/lib/apt/lists/*

COPY build.sh /usr/local/bin/hydra-container-build
RUN chmod 755 /usr/local/bin/hydra-container-build
ENTRYPOINT ["/usr/local/bin/hydra-container-build"]
